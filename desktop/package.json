{
  "name": "@icam/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "iCam Studio 4K para Windows (Electron + React)",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@icam/shared-types": "*",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
